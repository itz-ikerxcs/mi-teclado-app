<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#201A18">

    <!-- Barra Superior estilo Gboard -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="#2B2220">

        <Button
            android:id="@+id/btnAcentoUS"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="🇺🇸 US"
            android:textSize="13sp"
            android:textColor="#F5E0D8"
            android:backgroundTint="#3D322F"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnAcentoUK"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="🇬🇧 UK"
            android:textSize="13sp"
            android:textColor="#F5E0D8"
            android:backgroundTint="#3D322F"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnTraducir"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="38dp"
            android:text="✨ Traducir"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#201A18"
            android:backgroundTint="#F8BDAC" />
    </LinearLayout>

    <!-- Panel de Teclado -->
    <android.inputmethodservice.KeyboardView
        android:id="@+id/keyboardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#201A18"
        android:keyTextColor="#F5E0D8"
        android:keyTextSize="20sp"
        android:labelTextSize="14sp"
        android:focusable="true"
        android:focusableInTouchMode="true" />

</LinearLayout>
